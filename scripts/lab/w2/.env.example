# Réglages du poste W2 du lab (copier en scripts/lab/w2/.env, jamais commité).
# Compte administrateur local du poste Windows de lab.
LAB_W2_USERNAME=agent
LAB_W2_PASSWORD=
# Ports sur 127.0.0.1 : visionneuse web et bureau à distance (13389 évite le 3389 de l'hôte).
LAB_W2_WEB_PORT=8006
LAB_W2_RDP_PORT=13389
# Postes Chromium C1 et C2 (https://127.0.0.1:<port>, via le relais).
LAB_C1_WEB_PORT=3011
LAB_C2_WEB_PORT=3012
# Réseau interne du lab et adresse fixe du relais (adresse de la GED pour les postes).
LAB_INT_SUBNET=10.237.40.0/24
LAB_RELAY_IP=10.237.40.10
