# Database
DATABASE_URL=postgresql+asyncpg://edossier_user:your_password@localhost:5432/edossier
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage/files
# Directory import: container paths the API may read (':'-separated on Linux).
# Empty = every POST /documents/ingest-directory answers 403 INGEST_PATH_FORBIDDEN.
INGEST_ALLOWED_ROOTS=/data/ingest

# Per-file upload cap (documents, versions, bulk imports); 413 FILE_TOO_LARGE above it.
# Keep nginx client_max_body_size at least 1M above this value.
MAX_UPLOAD_SIZE_MB=100

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development
# DEBUG only toggles SQL echo; never relaxes rate limits.
DEBUG=false

# Auth rate limits per client IP (slowapi syntax). Set TRUSTED_PROXY=true only
# behind a reverse proxy that sets X-Forwarded-For (nginx/nginx.conf).
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_OTP_RATE_LIMIT=5/minute
AUTH_REFRESH_RATE_LIMIT=10/minute
TRUSTED_PROXY=false

# Logging
LOG_LEVEL=INFO
