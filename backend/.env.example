# Version exposed by /health and the OpenAPI schema. Set from the git tag at
# release time (e.g. APP_VERSION=1.0.0-rc.1); unset = development build.
APP_VERSION=0.0.0-dev

# Database
DATABASE_URL=postgresql+asyncpg://edossier_user:your_password@localhost:5432/edossier
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage/files
# Directory import: container paths the API may read (':'-separated on Linux).
# Empty = every POST /documents/ingest-directory answers 403 INGEST_PATH_FORBIDDEN.
INGEST_ALLOWED_ROOTS=/data/ingest
# Watched folders, ingested every INGEST_WATCH_INTERVAL_SECONDS by the worker (0 = off).
# JSON list; each path under INGEST_ALLOWED_ROOTS. tenant_code = tenant short name.
# Processed files move to <path>/_traites/AAAA-MM-JJ/, failed ones to <path>/_erreurs/.
# Example: [{"path": "/data/ingest/courrier", "tenant_code": "MINFI",
#            "org_unit_code": "SG", "matricule": "ADM001", "document_category_code": "COURRIER"}]
INGEST_WATCH_FOLDERS=[]
INGEST_WATCH_INTERVAL_SECONDS=60
# Files modified less than this many seconds ago are still being copied: next pass.
INGEST_WATCH_SETTLE_SECONDS=10
# Folders imported by hand (demo live import): a watched folder that is, contains or sits
# inside one of them is ignored. Same format as INGEST_ALLOWED_ROOTS.
INGEST_WATCH_PROTECTED_DIRS=/data/ingest/live

# Per-file upload cap (documents, versions, bulk imports); 413 FILE_TOO_LARGE above it.
# Keep nginx client_max_body_size at least 1M above this value.
MAX_UPLOAD_SIZE_MB=100
# Storage quota (MB) given to a new tenant; changed per tenant afterwards.
DEFAULT_TENANT_STORAGE_QUOTA_MB=5120

# Trash: documents trashed for more than TRASH_RETENTION_DAYS are deleted for good by the
# worker every TRASH_PURGE_INTERVAL_SECONDS (0 days = off). Signed or archived ones never.
# TRASH_PURGE_BATCH: documents per pass and per "empty the trash" call (1-1000).
TRASH_RETENTION_DAYS=0
TRASH_PURGE_INTERVAL_SECONDS=3600
TRASH_PURGE_BATCH=200

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development
# DEBUG only toggles SQL echo; never relaxes rate limits.
DEBUG=false

# Auth rate limits per client IP (slowapi syntax). Set TRUSTED_PROXY=true only
# behind a reverse proxy that sets X-Forwarded-For (nginx/nginx.conf).
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_OTP_RATE_LIMIT=5/minute
AUTH_REFRESH_RATE_LIMIT=10/minute
# Account locked for AUTH_LOCKOUT_SECONDS after AUTH_OTP_MAX_FAILURES wrong OTP codes.
AUTH_OTP_MAX_FAILURES=3
AUTH_LOCKOUT_SECONDS=900
TRUSTED_PROXY=false

# Logging
LOG_LEVEL=INFO

# Authorization: csv (policy.csv), sql, or shadow (csv decides, sql compared).
AUTHZ_BACKEND=csv
# Policy database for sql/shadow; empty = DATABASE_URL.
AUTHZ_POLICY_DATABASE_URL=
# Decision counters: memory, or redis (then AUTHZ_METRICS_REDIS_URL is used).
AUTHZ_METRICS_BACKEND=memory
AUTHZ_METRICS_REDIS_URL=
AUTHZ_METRICS_REDIS_PREFIX=authz:metrics

# Startup check that the database is at the Alembic head: fail, warn or off.
SCHEMA_CHECK_MODE=fail

# Email (Resend): off by default; the key stays out of the repository.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# My documents: remembers the documents each user opens (off by default).
RECENT_DOCUMENTS_TRACKING_ENABLED=false
RECENT_DOCUMENTS_MAX_PER_USER=50
# OCR engine tried first on photos and screenshots: tesseract (default, light) or
# easyocr (torch, ~1.3 GB per worker process). The other engine stays the fallback.
OCR_PRIMARY_ENGINE=rapidocr
# Kill switch: false routes everything to Tesseract (restart the worker, no rebuild).
OCR_RAPIDOCR_ENABLED=true
# Longest side sent to RapidOCR (px): 1800 keeps the memory peak under 800 MB (recall -0.64 pt vs 2000).
OCR_RAPIDOCR_MAX_SIDE=1800
OCR_RAPIDOCR_TIMEOUT_SECONDS=60
# Fallback to the other engine when the first text is empty or low-confidence. Off by
# default: EasyOCR exceeds the 2 GB worker limit and the task gets killed.
OCR_FALLBACK_ENABLED=false
