# Variables lues par docker-compose.yml et par ops/backup.sh / ops/restore.sh.
# Copier en .env (ignoré par git) et adapter. Ne jamais committer le .env.

# --- Pile compose ---
# Mot de passe PostgreSQL (utilisateur edossier_user, base edossier).
DB_PASSWORD=changeme
# Clé de signature des JWT de l'API.
SECRET_KEY=dev-secret-key-change-in-production
# Port hôte du reverse proxy nginx.
APP_PORT=8080
# Nom de projet compose (préfixe des conteneurs, réseaux et volumes). Défaut : nom du dossier.
# COMPOSE_PROJECT_NAME=ged237

# --- Sauvegarde / restauration (DOCS/exploitation/sauvegarde-restauration.md) ---
# Dossier des sauvegardes (un sous-dossier ged237-<horodatage UTC> par exécution).
BACKUP_DIR=./backups
# Nombre de sauvegardes conservées ; 0 = tout garder.
BACKUP_RETENTION=7
# Arrêter api et worker pendant la sauvegarde/restauration (1) ou non (0).
BACKUP_STOP_SERVICES=1
# Conteneur utilitaire (tar, gzip, sha256sum) et ses plafonds.
BACKUP_HELPER_IMAGE=python:3.12-slim
BACKUP_HELPER_MEMORY=256m
BACKUP_HELPER_CPUS=1
# Cible désignée hors pile compose (sinon découverte via docker compose ps) :
# PG_CONTAINER=
# STORAGE_VOLUME=
