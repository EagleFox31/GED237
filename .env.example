# Variables lues par docker-compose.yml et par ops/backup.sh / ops/restore.sh.
# Copier en .env (ignoré par git) et adapter. Ne jamais committer le .env.

# --- Pile compose ---
# Mot de passe PostgreSQL (utilisateur edossier_user, base edossier).
DB_PASSWORD=changeme
# Clé de signature des JWT de l'API.
SECRET_KEY=dev-secret-key-change-in-production
# Port hôte du reverse proxy nginx.
APP_PORT=8080
# Nom de projet compose (préfixe des conteneurs, réseaux et volumes). Défaut : nom du dossier.
# COMPOSE_PROJECT_NAME=ged237

# Écran de connexion (développement seulement). false = démo devant un public : pas de
# profils de démo, code OTP non pré-rempli. L'animateur le lit avec
# `docker compose logs -f api | grep "Code OTP"`. Puis `docker compose up -d api frontend`.
# Image de production du front : valeur figée au build, reconstruire avec
# `--build-arg VITE_LOGIN_DEMO_HINTS=<même valeur>`.
LOGIN_DEMO_HINTS=true
# Tickets d'ouverture du canal de notifications en direct, par utilisateur (un par ouverture,
# reconnexions comprises). Au-delà : 429. Après modification : `docker compose up -d api`.
AUTH_WS_TICKET_RATE_LIMIT=30/minute

# --- Sauvegarde / restauration (DOCS/exploitation/sauvegarde-restauration.md) ---
# Dossier des sauvegardes (un sous-dossier ged237-<horodatage UTC> par exécution).
BACKUP_DIR=./backups
# Nombre de sauvegardes conservées ; 0 = tout garder.
BACKUP_RETENTION=7
# Arrêter api et worker pendant la sauvegarde/restauration (1) ou non (0).
BACKUP_STOP_SERVICES=1
# Conteneur utilitaire (tar, gzip, sha256sum) et ses plafonds.
BACKUP_HELPER_IMAGE=python:3.12-slim
BACKUP_HELPER_MEMORY=256m
BACKUP_HELPER_CPUS=1
# Proxys relancés après la relance d'api (sinon 502), puis /health vérifié (essais, 1 par seconde).
BACKUP_PROXY_SERVICES="nginx nginx-tls"
BACKUP_HEALTH_TRIES=30
# Cible désignée hors pile compose (sinon découverte via docker compose ps) :
# PG_CONTAINER=
# STORAGE_VOLUME=

# Moteur OCR essayé en premier sur les photos et captures : rapidocr (défaut), tesseract
# (léger) ou easyocr (torch, ~1,3 Go par processus du worker). Tesseract reste le repli.
# Le worker tourne en --concurrency=1 : deux enfants EasyOCR dépasseraient les 2 Go.
# Ces réglages ne vont qu'au worker : après modification, `docker compose up -d worker`
# (`restart` ne relit pas ce fichier).
OCR_PRIMARY_ENGINE=rapidocr
# Coupe-circuit : false renvoie tout vers Tesseract (sans rebuild).
OCR_RAPIDOCR_ENABLED=true
# Plus grand côté envoyé à RapidOCR (px) : 1800 garde le pic mémoire sous 800 Mo (rappel -0,64 pt vs 2000).
OCR_RAPIDOCR_MAX_SIDE=1800
OCR_RAPIDOCR_TIMEOUT_SECONDS=60
# Repli sur l'autre moteur quand le premier texte est vide ou peu fiable. Désactivé par
# défaut : EasyOCR dépasse la limite mémoire du worker (2 Go) et la tâche est tuée.
OCR_FALLBACK_ENABLED=false

# Notifications en direct : off (liste seulement, défaut), local (une seule instance de l'API)
# ou redis (plusieurs instances reliées au même Redis).
NOTIFICATIONS_BROADCAST_MODE=off
# Corbeille : au-delà de TRASH_RETENTION_DAYS jours, le worker supprime définitivement les
# documents mis à la corbeille (0 = jamais ; signés ou archivés jamais). Mêmes valeurs api et worker.
TRASH_RETENTION_DAYS=0
TRASH_PURGE_INTERVAL_SECONDS=3600
# Documents traités par passe et par appel « Vider la corbeille » (1 à 1000).
TRASH_PURGE_BATCH=200

# Taille maximale d'un fichier envoyé (Mo). Lue par l'API et par l'écran d'envoi, qui refuse
# un fichier trop gros avant l'envoi. Après modification : `docker compose up -d api worker frontend`.
# Image de production du front : valeur figée au build, reconstruire avec
# `--build-arg VITE_MAX_UPLOAD_SIZE_MB=<même valeur>`.
MAX_UPLOAD_SIZE_MB=100
