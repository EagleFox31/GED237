# Variables lues par docker-compose.yml et par ops/backup.sh / ops/restore.sh.
# Copier en .env (ignoré par git) et adapter. Ne jamais committer le .env.

# --- Pile compose ---
# Mot de passe PostgreSQL (utilisateur edossier_user, base edossier).
DB_PASSWORD=changeme
# Clé de signature des JWT de l'API.
SECRET_KEY=dev-secret-key-change-in-production
# Port hôte du reverse proxy nginx.
APP_PORT=8080
# Nom de projet compose (préfixe des conteneurs, réseaux et volumes). Défaut : nom du dossier.
# COMPOSE_PROJECT_NAME=ged237

# --- Sauvegarde / restauration (DOCS/exploitation/sauvegarde-restauration.md) ---
# Dossier des sauvegardes (un sous-dossier ged237-<horodatage UTC> par exécution).
BACKUP_DIR=./backups
# Nombre de sauvegardes conservées ; 0 = tout garder.
BACKUP_RETENTION=7
# Arrêter api et worker pendant la sauvegarde/restauration (1) ou non (0).
BACKUP_STOP_SERVICES=1
# Conteneur utilitaire (tar, gzip, sha256sum) et ses plafonds.
BACKUP_HELPER_IMAGE=python:3.12-slim
BACKUP_HELPER_MEMORY=256m
BACKUP_HELPER_CPUS=1
# Cible désignée hors pile compose (sinon découverte via docker compose ps) :
# PG_CONTAINER=
# STORAGE_VOLUME=

# Moteur OCR essayé en premier sur les photos et captures : tesseract (défaut, léger) ou
# easyocr (torch, ~1,3 Go par processus du worker). L'autre moteur reste le repli.
# Le worker tourne en --concurrency=1 : deux enfants EasyOCR dépasseraient les 2 Go.
OCR_PRIMARY_ENGINE=rapidocr
# Coupe-circuit : false renvoie tout vers Tesseract (redémarrer le worker, sans rebuild).
OCR_RAPIDOCR_ENABLED=true
# Plus grand côté envoyé à RapidOCR (px) : 1800 garde le pic mémoire sous 800 Mo (rappel -0,64 pt vs 2000).
OCR_RAPIDOCR_MAX_SIDE=1800
OCR_RAPIDOCR_TIMEOUT_SECONDS=60
# Repli sur l'autre moteur quand le premier texte est vide ou peu fiable. Désactivé par
# défaut : EasyOCR dépasse la limite mémoire du worker (2 Go) et la tâche est tuée.
OCR_FALLBACK_ENABLED=false

# Version affichée par l'API (/health). Posée par la release depuis le tag git ; ne pas la fixer à la main.
# APP_VERSION=1.0.0

# Taille maximale d'un fichier déposé, en Mo (tous les chemins d'import).
MAX_UPLOAD_SIZE_MB=100

# Dossiers surveillés (import automatique) : liste JSON, voir DOCS. Vide : rien n'est surveillé.
INGEST_WATCH_FOLDERS=[]
# Intervalle entre deux passages, en secondes (0 désactive).
INGEST_WATCH_INTERVAL_SECONDS=60
# Dossiers importés à la main, jamais vidés par la surveillance (séparés par ':').
INGEST_WATCH_PROTECTED_DIRS=/data/ingest/live

# E-mails de compte : désactivés tant qu'aucune clé n'est posée.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
