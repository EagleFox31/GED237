# Line endings belong to the repository, not to the workstation (LESSON-2026-003).
# Text is stored and checked out as LF everywhere: shell scripts and Dockerfiles run in Linux containers.
* text=auto eol=lf

# Windows command scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
